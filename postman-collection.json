{
  "info": {
    "name": "Mi Primer Quarkus API",
    "description": "API REST para gestión de productos y tareas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar todos los productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Listar productos con paginación",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?page=0&size=10&sortBy=nombre",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "sortBy", "value": "nombre"}
              ]
            }
          }
        },
        {
          "name": "Buscar productos por nombre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?search=laptop",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                {"key": "search", "value": "laptop"}
              ]
            }
          }
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Nuevo Producto\",\n    \"precio\": 99.99,\n    \"stock\": 10\n}"
            }
          }
        },
        {
          "name": "Actualizar producto (PUT)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Producto Actualizado\",\n    \"precio\": 149.99,\n    \"stock\": 20\n}"
            }
          }
        },
        {
          "name": "Actualizar producto (PATCH)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"precio\": 79.99\n}"
            }
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Tareas",
      "item": [
        {
          "name": "Listar todas las tareas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": ["{{baseUrl}}"],
              "path": ["tareas"]
            }
          }
        },
        {
          "name": "Obtener tarea por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tareas/1",
              "host": ["{{baseUrl}}"],
              "path": ["tareas", "1"]
            }
          }
        },
        {
          "name": "Crear tarea",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": ["{{baseUrl}}"],
              "path": ["tareas"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Nueva Tarea\",\n    \"descripcion\": \"Descripción de la tarea\",\n    \"terminada\": false\n}"
            }
          }
        },
        {
          "name": "Actualizar tarea (PUT)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/tareas/1",
              "host": ["{{baseUrl}}"],
              "path": ["tareas", "1"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Tarea Actualizada\",\n    \"descripcion\": \"Nueva descripción\",\n    \"terminada\": true\n}"
            }
          }
        },
        {
          "name": "Actualizar tarea (PATCH)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/tareas/1",
              "host": ["{{baseUrl}}"],
              "path": ["tareas", "1"]
            },
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"terminada\": true\n}"
            }
          }
        },
        {
          "name": "Eliminar tarea",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/tareas/1",
              "host": ["{{baseUrl}}"],
              "path": ["tareas", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"]
            }
          }
        },
        {
          "name": "Obtener categoría por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Proveedores",
      "item": [
        {
          "name": "Listar proveedores",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/proveedores",
              "host": ["{{baseUrl}}"],
              "path": ["proveedores"]
            }
          }
        },
        {
          "name": "Obtener proveedor por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/proveedores/1",
              "host": ["{{baseUrl}}"],
              "path": ["proveedores", "1"]
            }
          }
        }
      ]
    }
  ]
}
